{
  "version": "qc-1",
  "note": "Demonstration policy on synthetic data. Thresholds are engineering thresholds, not medical thresholds.",
  "known_code_systems": [
    "http://snomed.info/sct", "http://loinc.org", "http://www.nlm.nih.gov/research/umls/rxnorm",
    "http://terminology.hl7.org/CodeSystem/v3-ActCode", "http://terminology.hl7.org/CodeSystem/condition-clinical",
    "http://terminology.hl7.org/CodeSystem/condition-ver-status", "http://terminology.hl7.org/CodeSystem/condition-category",
    "http://terminology.hl7.org/CodeSystem/observation-category", "http://terminology.hl7.org/CodeSystem/data-absent-reason",
    "http://terminology.hl7.org/CodeSystem/v3-ParticipationType", "http://terminology.hl7.org/CodeSystem/organization-type",
    "http://terminology.hl7.org/CodeSystem/medicationrequest-category", "http://unitsofmeasure.org",
    "http://hl7.org/fhir/sid/cvx", "http://www.ama-assn.org/go/cpt", "urn:ietf:bcp:47"
  ],
  "checks": [
    {"id": "batch.manifest", "category": "format", "scope": "batch", "severity": "fatal", "blocking": true,
     "description": "Manifest parses and follows contract v1 (synthetic=true, sorted safe relative paths, limits).",
     "implementation": "healthlake.ingestion.manifest.parse_manifest; discovery reports the error, batch not registered"},
    {"id": "batch.integrity", "category": "hash", "scope": "batch", "severity": "fatal", "blocking": true,
     "description": "Every declared file exists with its size and SHA-256; no undeclared file, no symlink.",
     "implementation": "healthlake.ingestion.registry.verify_batch; ctl.batch.status=invalid"},
    {"id": "batch.revision_conflict", "category": "uniqueness", "scope": "batch", "severity": "fatal", "blocking": true,
     "description": "Same source_id and source_revision registered with different content.",
     "implementation": "registry.register_batch; exit code 5"},
    {"id": "bronze.reconciliation", "category": "hash", "scope": "store", "severity": "error", "blocking": false,
     "description": "Every registered Bronze object exists and matches its hash; unregistered objects are listed.",
     "implementation": "healthlake verify-bronze"},
    {"id": "format.json", "category": "format", "scope": "file", "severity": "fatal", "blocking": true,
     "description": "JSON file parses (UTF-8).", "implementation": "adapters"},
    {"id": "format.fhir_bundle", "category": "format", "scope": "file", "severity": "fatal", "blocking": true,
     "description": "File is a FHIR Bundle of a supported type.", "implementation": "adapters.fhir_bundle"},
    {"id": "format.csv", "category": "format", "scope": "file", "severity": "fatal", "blocking": true,
     "description": "CSV file is expected, UTF-8, parseable, with the exact horizon-csv-v1 header.",
     "implementation": "adapters.horizon"},
    {"id": "format.row", "category": "format", "scope": "resource", "severity": "error", "blocking": false,
     "description": "A row/record can be mapped to FHIR (column count, numbers, booleans).", "implementation": "adapters.horizon"},
    {"id": "format.fatal_files", "category": "format", "scope": "processing", "severity": "fatal", "blocking": true,
     "description": "Gate: no fatal file issue in the processing.", "implementation": "quality.processing_gate"},
    {"id": "fhir.id", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "Resource id present and a valid FHIR id.", "implementation": "validation.structural"},
    {"id": "fhir.structure", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "resourceType consistent, meta is an object, entry has a resource.", "implementation": "validation.structural"},
    {"id": "fhir.required", "category": "completeness", "scope": "resource", "severity": "error", "blocking": false,
     "description": "Elements required by FHIR R4 or by HealthLake analytics (subject, code, class, medication[x]).",
     "implementation": "validation.structural"},
    {"id": "fhir.valueset", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "R4 required value sets: gender, statuses, intent, clinical status.", "implementation": "validation.structural"},
    {"id": "fhir.datatype", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "date/dateTime formats (zone required with a time), numbers, booleans.", "implementation": "validation.structural"},
    {"id": "fhir.cardinality", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "At most one value[x].", "implementation": "validation.structural"},
    {"id": "fhir.invariant", "category": "fhir", "scope": "resource", "severity": "error", "blocking": false,
     "description": "obs-6: dataAbsentReason only without value[x].", "implementation": "validation.structural"},
    {"id": "fhir.hl7_validator", "category": "fhir", "scope": "resource", "severity": "warning", "blocking": false,
     "description": "Official HL7 validator finding on the audit sample (ADR 0003).", "implementation": "validation.hl7"},
    {"id": "fhir.hl7_validator_sample", "category": "fhir", "scope": "processing", "severity": "warning",
     "blocking": false, "description": "Audit status: number of unexplained HL7 validator errors in the sample.",
     "implementation": "validation.hl7 + quality.processing_gate"},
    {"id": "temporal.period", "category": "temporal", "scope": "resource", "severity": "error", "blocking": false,
     "description": "Encounter end >= start; Condition abatement >= onset.", "implementation": "validation.structural"},
    {"id": "value.extreme", "category": "extremes", "scope": "resource", "severity": "warning", "blocking": false,
     "description": "Quantity outside the plausibility range of config/plausibility.json (same code and unit only).",
     "implementation": "validation.plausibility"},
    {"id": "reference.resolution", "category": "referential", "scope": "resource", "severity": "error",
     "blocking": false, "description": "Required references resolve; ambiguous, wrongly typed or external references refused (optional unresolved = warning).",
     "implementation": "pipelines.resolve"},
    {"id": "reference.dependency", "category": "referential", "scope": "resource", "severity": "error",
     "blocking": false, "description": "Reference to a resource rejected in the same batch (cause recorded).",
     "implementation": "pipelines.resolve"},
    {"id": "consistency.patient_encounter", "category": "patient-encounter", "scope": "resource", "severity": "error",
     "blocking": false, "description": "Subject equals the patient of the referenced Encounter.", "implementation": "pipelines.resolve"},
    {"id": "identity.conflict", "category": "uniqueness", "scope": "processing", "severity": "fatal", "blocking": true,
     "description": "One identity-system identifier claimed by two identities (same source).", "implementation": "pipelines.resolve"},
    {"id": "identity.content_conflict", "category": "uniqueness", "scope": "processing", "severity": "fatal",
     "blocking": true, "description": "Same identity twice with different content in one revision.", "implementation": "pipelines.resolve"},
    {"id": "identity.invalid_update", "category": "uniqueness", "scope": "processing", "severity": "fatal",
     "blocking": true, "description": "Invalid content for an identity already in Silver.", "implementation": "pipelines.resolve"},
    {"id": "identity.conflicts", "category": "uniqueness", "scope": "processing", "severity": "fatal", "blocking": true,
     "description": "Gate: 0 identity or content conflict.", "threshold": 0, "implementation": "quality.processing_gate"},
    {"id": "identity.invalid_updates", "category": "uniqueness", "scope": "processing", "severity": "fatal",
     "blocking": true, "description": "Gate: 0 invalid update.", "threshold": 0, "implementation": "quality.processing_gate"},
    {"id": "quarantine.reject_rate_new", "category": "completeness", "scope": "processing", "severity": "fatal",
     "blocking": true, "description": "Gate: rejected new resources / received new resources <= 1 %.", "threshold": 0.01,
     "implementation": "quality.processing_gate"},
    {"id": "reconciliation.occurrences", "category": "reconciliation", "scope": "processing", "severity": "fatal",
     "blocking": true, "description": "received = accepted + deduplicated + rejected + out_of_scope.", "threshold": 0,
     "implementation": "quality.processing_gate"},
    {"id": "dbt.tests", "category": "reconciliation", "scope": "release", "severity": "fatal", "blocking": true,
     "description": "All dbt tests pass (unique, not_null, relationships, patient/encounter, periods, aggregates, fan-out, components).",
     "threshold": 0, "implementation": "release.gate"},
    {"id": "dbt.models", "category": "completeness", "scope": "release", "severity": "fatal", "blocking": true,
     "description": "All dbt models built.", "threshold": 0, "implementation": "release.gate"},
    {"id": "release.schema_complete", "category": "completeness", "scope": "release", "severity": "fatal",
     "blocking": true, "description": "The 15 Gold marts exist.", "threshold": 0, "implementation": "release.gate"},
    {"id": "release.snapshot_dangling_references", "category": "referential", "scope": "release", "severity": "fatal",
     "blocking": true, "description": "Every reference of the snapshot points into the snapshot.", "threshold": 0,
     "implementation": "release.gate"},
    {"id": "release.gold_reconciles_snapshot", "category": "reconciliation", "scope": "release", "severity": "fatal",
     "blocking": true, "description": "Gold row count per projected type equals snapshot members.", "threshold": 0,
     "implementation": "release.gate"},
    {"id": "release.processings_passed", "category": "reconciliation", "scope": "release", "severity": "fatal",
     "blocking": true, "description": "Every included processing passed its own gate.", "threshold": 0,
     "implementation": "release.gate"},
    {"id": "release.terminology_coverage", "category": "terminology", "scope": "release", "severity": "warning",
     "blocking": false, "description": "Share of codings of the snapshot whose system is in known_code_systems. Codes are NOT validated against a terminology server.",
     "threshold": 0.95, "implementation": "release.gate (observations)"},
    {"id": "release.freshness_clinical_data", "category": "freshness", "scope": "release", "severity": "warning",
     "blocking": false, "description": "Days between the batches' reference_date and the latest encounter start.",
     "threshold": 90, "implementation": "release.gate (observations)"},
    {"id": "release.completeness_encounter_end", "category": "completeness", "scope": "release", "severity": "info",
     "blocking": false, "description": "Share of encounters with an end instant (informational).",
     "implementation": "release.gate (observations)"},
    {"id": "release.completeness_observation_effective", "category": "completeness", "scope": "release",
     "severity": "info", "blocking": false, "description": "Share of observations with an effective instant (informational).",
     "implementation": "release.gate (observations)"}
  ]
}
